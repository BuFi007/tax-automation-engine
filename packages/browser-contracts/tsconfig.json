{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "isolatedModules": true,
    "moduleDetection": "force",
    "declarationMap": false,
    "sourceMap": false,
    "types": ["bun"]
