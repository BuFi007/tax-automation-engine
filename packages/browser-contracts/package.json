{
  "name": "@tax-engine/browser-contracts",
  "version": "0.4.0",
  "description": "Browser-safe runtime contracts shared by the Tax Engine, Open Agents, and Desk.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuFi007/tax-automation-engine.git",
    "directory": "packages/browser-contracts"
  },
  "keywords": [
    "tax-engine",
    "browser-contracts",
    "zod"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./scenarios": {
      "types": "./dist/scenario-fixtures.d.ts",
      "import": "./dist/scenario-fixtures.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "COMPATIBILITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "test:package": "bun test ./test/package-surface.packaging.ts",
    "prepack": "bun run typecheck && bun run test && bun run build && bun run test:package"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "tsup": "^8.3.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
