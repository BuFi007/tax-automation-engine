{
  "name": "@tax-engine/wsfex-signer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "bun test src",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:build": "wrangler deploy --dry-run --outdir dist-worker",
    "verify:wsdl": "bun scripts/verify-wsdl.ts"
  },
  "dependencies": {
    "@tax-engine/core": "workspace:*",
    "@tax-engine/sql-store": "workspace:*",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3",
    "wrangler": "4.151.3"
  }
}
