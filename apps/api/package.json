{
  "name": "@tax-engine/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "homologation:preflight": "bun src/homologation-cli.ts preflight",
    "homologation:probe-signer": "bun src/homologation-cli.ts probe-signer",
    "homologation:validate": "bun src/homologation-cli.ts validate-report"
  },
  "dependencies": {
    "@reclaimprotocol/js-sdk": "5.8.0",
    "@tax-engine/core": "workspace:*",
    "@tax-engine/erp": "workspace:*",
    "@tax-engine/wsfex-signer": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
