{
  // Factura C (WSFE) signer: one SQLite-backed Durable Object (`WsfeSignerState`) holds the
  // attempt store. No public surface: no workers.dev, no preview URLs, no routes.
  // The Tax API reaches it only through its WSFE_SIGNER Service Binding, and it
  // reaches the boundary only through the boundary's SignerEntrypoint.
  // Deploy with `wrangler deploy` only, never `wrangler versions upload`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bufi-wsfe-signer-homologation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // The store opens a file only on Bun; the Worker always injects the Durable Object database.
  "alias": { "bun:sqlite": "../../packages/sql-store/src/bun-sqlite-unavailable.ts" },
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "SIGNER_STATE", "class_name": "WsfeSignerState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WsfeSignerState"] }],
  "services": [
    { "binding": "ARCA_BOUNDARY", "service": "bufi-arca-boundary-homologation", "entrypoint": "SignerEntrypoint" }
  ],
  "observability": { "enabled": true },
  // The URLs are never resolved: calls to them go through the ARCA_BOUNDARY binding.
  "vars": {
    "ARCA_ENVIRONMENT": "homologation",
    "WSFE_SIGNER_VAULT_URL": "https://arca-boundary.internal",
    "WSFE_WSAA_BROKER_URL": "https://arca-boundary.internal"
  },
  // Secrets (wrangler secret bulk): WSFE_SIGNER_API_TOKEN, WSFE_SIGNER_VAULT_TOKEN,
  // WSFE_WSAA_BROKER_TOKEN.
  "env": {
    // Not deployed by the Workers plan; see its Phase 7 prerequisites.
    "production": {
      "name": "bufi-wsfe-signer",
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "SIGNER_STATE", "class_name": "WsfeSignerState" }]
      },
      "services": [
        { "binding": "ARCA_BOUNDARY", "service": "bufi-arca-boundary", "entrypoint": "SignerEntrypoint" }
      ],
      "vars": {
        "ARCA_ENVIRONMENT": "production",
        "WSFE_SIGNER_VAULT_URL": "https://arca-boundary.internal",
        "WSFE_WSAA_BROKER_URL": "https://arca-boundary.internal"
      }
    }
  }
}
