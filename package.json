{
  "name": "tax-automation-engine",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "bun --filter @tax-engine/web dev",
    "dev:api": "bun --filter @tax-engine/api dev",
    "dev:signer": "bun --filter @tax-engine/wsfex-signer dev",
    "dev:wsfe-signer": "bun --filter @tax-engine/wsfe-signer dev",
    "dev:wsfecred": "bun --filter @tax-engine/wsfecred dev",
    "dev:arca-boundary": "bun --filter @tax-engine/arca-boundary dev",
    "dev:proof-vault": "bun --filter @tax-engine/reclaim-proof-vault dev",
    "build": "bun --filter @tax-engine/browser-contracts build && bun run --filter '*' build",
    "typecheck": "bun --filter @tax-engine/browser-contracts build && bun run --filter '*' typecheck",
    "test": "bun --filter @tax-engine/browser-contracts build && bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "homologation:preflight": "bun --filter @tax-engine/api homologation:preflight",
    "homologation:probe-signer": "bun --filter @tax-engine/api homologation:probe-signer",
    "homologation:probe-wsfe-signer": "bun --filter @tax-engine/api homologation:probe-wsfe-signer",
    "homologation:probe-proof-vault": "bun --filter @tax-engine/api homologation:probe-proof-vault",
    "homologation:validate": "bun --filter @tax-engine/api homologation:validate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
