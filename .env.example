PORT=4100
VITE_API_URL=http://localhost:4100
TAX_ENGINE_API_KEY=
# Separate trusted-channel tokens. Never give these to the tax agent runtime.
TAX_ENGINE_USER_APPROVAL_TOKEN=
TAX_ENGINE_ACCOUNTANT_APPROVAL_TOKEN=
TAX_ENGINE_EVIDENCE_INGEST_TOKEN=
# Server-only. Never expose taxpayer credentials or private keys to the browser.
ARCA_SIGNER_URL=
ARCA_SIGNER_TOKEN=
ARCA_ENVIRONMENT=homologacion
# Explicit acceptance gates; never enable these without the named external approvals.
ARCA_HOMOLOGATION_AUTHORIZED=false
ARCA_HOMOLOGATION_TEST_IDENTITY_APPROVED=false
ARCA_WSFEX_DELEGATION_CONFIRMED=false
TAX_ENGINE_PRODUCTION_APPROVED=false
# Isolated WSFEX signer deployment. ARCA_SIGNER_TOKEN and
# WSFEX_SIGNER_API_TOKEN must agree across their separate deployments.
WSFEX_SIGNER_API_TOKEN=
WSFEX_SIGNER_VAULT_URL=
WSFEX_SIGNER_VAULT_TOKEN=
WSFEX_WSAA_BROKER_URL=
WSFEX_WSAA_BROKER_TOKEN=
WSFEX_SIGNER_DB_PATH=/data/wsfex-signer.sqlite
WSFEX_SIGNER_VERSION=0.1.0
WSFEX_SIGNER_PRODUCTION_APPROVED=false
# Server-only Reclaim credentials and the two reviewed ARCA provider IDs.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_CALLBACK_BASE_URL=https://tax-api.example.com
RECLAIM_CALLBACK_MAX_BYTES=52428800
RECLAIM_ARCA_TAXPAYER_PROVIDER_ID=
RECLAIM_ARCA_TAXPAYER_PROVIDER_REVIEWED=false
RECLAIM_ARCA_CAE_PROVIDER_ID=
RECLAIM_ARCA_CAE_PROVIDER_REVIEWED=false
# Optional hardening for providers configured to return Reclaim TEE attestations.
RECLAIM_REQUIRE_TEE=false
# Optional external encrypted proof custody. Raw proofs never enter the Motora database.
RECLAIM_PROOF_CUSTODY_REQUIRED=false
RECLAIM_PROOF_VAULT_URL=
RECLAIM_PROOF_VAULT_TOKEN=
RECLAIM_PROOF_RETENTION_POLICY_ID=
