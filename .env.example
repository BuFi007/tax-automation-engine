PORT=4100
VITE_API_URL=http://localhost:4100
# Required in production. Mount /data on durable storage; in-memory SQLite is rejected.
TAX_ENGINE_DB_PATH=/data/tax-engine.sqlite
TAX_ENGINE_API_KEY=
# Separate trusted-channel tokens. Never give these to the tax agent runtime.
TAX_ENGINE_USER_APPROVAL_TOKEN=
TAX_ENGINE_ACCOUNTANT_APPROVAL_TOKEN=
TAX_ENGINE_EVIDENCE_INGEST_TOKEN=
TAX_ENGINE_CONSENT_EVENT_TOKEN=
TAX_ENGINE_SNAPSHOT_PROJECTOR_TOKEN=
TAX_ENGINE_AUTHORITY_PAYLOAD_TOKEN=
# Short-lived, workspace-scoped principal assertions. Keep each secret only in
# the named caller and this API; do not share one secret across trust domains.
TAX_ENGINE_USER_PRINCIPAL_HMAC_SECRET=
# Motora's request-bound ARCA onboarding principal only. Never expose to browsers
# or reuse for invoice execution, user reads, evidence, or projection.
TAX_ENGINE_MOTORA_ONBOARDING_PRINCIPAL_HMAC_SECRET=
# External accountant workspace only (minimum 32 bytes). The short-lived principal is bound to
# actor, workspace, method, path and body; never expose it to a browser/model.
TAX_ENGINE_ACCOUNTANT_DECISION_INGRESS_ENABLED=false
TAX_ENGINE_ACCOUNTANT_DECISION_PRINCIPAL_HMAC_SECRET=
# Unattended projector only; never inject this or the user secret into a browser.
TAX_ENGINE_SNAPSHOT_PROJECTOR_PRINCIPAL_HMAC_SECRET=
TAX_ENGINE_EVIDENCE_PUBLISHER_PRINCIPAL_HMAC_SECRET=
TAX_ENGINE_CONSENT_AUTHORITY_PRINCIPAL_HMAC_SECRET=
# Body-, tool-, idempotency-, actor-, and workspace-bound Open Agents invokes.
TAX_ENGINE_OPEN_AGENTS_AGENT_PRINCIPAL_HMAC_SECRET=
# Dedicated server-to-server settlement ingress. This is not an agent tool
# credential; provision it only to the Invoice 2.0/Open Agents outbox adapter.
TAX_ENGINE_OPEN_AGENTS_INVOICE_SETTLEMENT_PRINCIPAL_HMAC_SECRET=
# Tax Engine → Open Agents TaxDomainEventV1 outbox. Keep all three values
# distinct from API, agent, authority, evidence, and settlement credentials.
TAX_DOMAIN_EVENT_DELIVERY_ENABLED=false
TAX_DOMAIN_EVENT_OPEN_AGENTS_URL=
TAX_DOMAIN_EVENT_OPEN_AGENTS_TOKEN=
TAX_DOMAIN_EVENT_HMAC_SECRET=
# 1-60 seconds; this drains the durable Tax event outbox without bypassing it.
TAX_DOMAIN_EVENT_POLL_INTERVAL_MS=5000
# Preview/local-only end-to-end corridor certification. Production needs an
# explicit owner gate and an isolated Open Agents certification endpoint.
OPEN_AGENTS_TAX_DOMAIN_EVENT_CERTIFICATION_SECRET=
TAX_DOMAIN_EVENT_CERTIFICATION_PRODUCTION_APPROVED=false
# Dedicated >=32-byte server-only key for workspace-scoped browser references.
# Never reuse a principal-signing secret or expose this value to Desk/browser code.
TAX_ENGINE_BROWSER_REFERENCE_HMAC_SECRET=
# Tax-owned Factura E authority corridor. Every principal secret is distinct;
# remote effects remain separately dark until homologation evidence is approved.
TAX_ENGINE_ARCA_AUTHORITY_CORRIDOR_ENABLED=false
TAX_ENGINE_ARCA_REMOTE_EFFECTS_ENABLED=false
TAX_ENGINE_ARCA_AUTHORITY_PRODUCTION_APPROVED=false
TAX_ENGINE_ARCA_REMOTE_EFFECTS_PRODUCTION_APPROVED=false
TAX_ENGINE_ARGENTINA_LAUNCH_POLICY_PATH=
# This process may publish consented factoring evidence, but it never moves advance funds.
TAX_ENGINE_INVOICE_ADVANCE_REMOTE_EFFECTS_ENABLED=false
TAX_ENGINE_MOTORA_AUTHORITY_PRINCIPAL_HMAC_SECRET=
TAX_ENGINE_OPEN_AGENTS_APPROVAL_PRINCIPAL_HMAC_SECRET=
TAX_AUTHORITY_EXECUTION_DB_PATH=/data/tax-authority-executions.sqlite
# Private Tax-owned resolver/allocator. Its receipt supplies the represented-CUIT
# commitment provisioned by the ARCA boundary; raw CUIT never enters Motora.
TAX_ENGINE_ARCA_PREPARATION_URL=
TAX_ENGINE_ARCA_PREPARATION_HMAC_SECRET=
# Factura E factoring feature. This publishes only a short-lived signed predicate;
# it never publishes CUIT, CAE, amount, dates, counterparty, POS or raw evidence.
TAX_FACTURA_E_FEATURE_PUBLICATION_ENABLED=false
TAX_FACTURA_E_FEATURE_PRODUCTION_APPROVED=false
TAX_FACTURA_E_FEATURE_DB_PATH=/data/tax-factura-e-features.sqlite
# Required with durable publication: exactly one process owns this SQLite writer.
TAX_FACTURA_E_FEATURE_SINGLE_WRITER=false
TAX_FACTURA_E_FEATURE_POLICY_VERSION=ar-factura-e-factoring-v1
# Must be 1-10s so the worker cannot miss the feature's 15s renewal window.
TAX_FACTURA_E_FEATURE_POLL_INTERVAL_MS=5000
TAX_FACTURA_E_FEATURE_COMMITMENT_HMAC_SECRET=
TAX_FACTURA_E_FEATURE_DESK_CONSENT_HMAC_SECRET=
TAX_FACTURA_E_FEATURE_PROJECTOR_HMAC_SECRET=
# Must equal standalone CRE's TAX_FEATURE_API_KEY secret.
TAX_FACTURA_E_FEATURE_CRE_READER_API_KEY=
# Mutation-only credential used by CRE reserve/consume/pre-consume release.
TAX_FACTURA_E_FEATURE_CRE_RESERVATION_API_KEY=
# Terminal mutations require independently reviewed Ed25519 verifiers. Signing
# private keys stay behind Desk/recovery KMS/HSM boundaries and never enter CRE.
TAX_FACTURA_E_FEATURE_DESK_EFFECT_RECEIPT_ENABLED=false
TAX_FACTURA_E_FEATURE_DESK_EFFECT_RECEIPT_PRODUCTION_APPROVED=false
TAX_FACTURA_E_FEATURE_DESK_EFFECT_RECEIPT_KEY_ID=
TAX_FACTURA_E_FEATURE_DESK_EFFECT_RECEIPT_ED25519_PUBLIC_KEY_PEM=
# Separate Desk terminal-delivery principal; ordinary CRE does not receive it.
TAX_FACTURA_E_FEATURE_DESK_EFFECT_RECEIPT_API_KEY=
TAX_FACTURA_E_FEATURE_NO_EFFECT_RECOVERY_ENABLED=false
TAX_FACTURA_E_FEATURE_NO_EFFECT_RECOVERY_PRODUCTION_APPROVED=false
TAX_FACTURA_E_FEATURE_NO_EFFECT_RECOVERY_KEY_ID=
TAX_FACTURA_E_FEATURE_NO_EFFECT_RECOVERY_ED25519_PUBLIC_KEY_PEM=
# Separate recovery transport principal; never provision this to ordinary CRE.
TAX_FACTURA_E_FEATURE_NO_EFFECT_RECOVERY_API_KEY=
# KMS/HSM-style Ed25519 digest signer; private key material never enters Tax.
TAX_FACTURA_E_FEATURE_SIGNER_URL=
TAX_FACTURA_E_FEATURE_SIGNER_KEY_VERSION=
# Pinned Ed25519 public key matching the remote signer (public PEM only).
TAX_FACTURA_E_FEATURE_SIGNER_PUBLIC_KEY_PEM=
TAX_FACTURA_E_FEATURE_SIGNER_HMAC_SECRET=
# Desk event ingress for active/withdrawn signed feature events.
TAX_FACTURA_E_FEATURE_EVENT_URL=
TAX_FACTURA_E_FEATURE_EVENT_HMAC_SECRET=
# Optional evidence limits (the server enforces a 5 MiB hard ceiling).
TAX_EVIDENCE_BATCH_MAX_BYTES=5242880
TAX_EVIDENCE_SOURCE_FRESHNESS_MAX_AGE_MS=86400000
# Local migration/testing only. The legacy append route is always disabled in production.
TAX_ENGINE_LEGACY_EVIDENCE_APPEND_ENABLED=false
# Local fixture UI only. This route is always dark in production.
TAX_ENGINE_DEMO_ROUTES_ENABLED=false
# Server-only. Never expose taxpayer credentials or private keys to the browser.
ARCA_SIGNER_URL=
ARCA_SIGNER_TOKEN=
# Tax-owned private preparation: Desk returns only immutable foreign-customer
# fields over HMAC; the signer independently reserves ARCA counters.
TAX_DESK_FACTURA_E_PRIVATE_DATA_URL=
TAX_DESK_FACTURA_E_PRIVATE_DATA_HMAC_SECRET=
TAX_ARCA_ISSUER_PROFILE_REGISTRY_JSON={}
# Optional reviewed additions; built-in launch mappings are ARS->PES and USD->DOL.
TAX_ARCA_CURRENCY_REGISTRY_JSON={}
# Isolated WSFE (Factura C) signer, a separate deployment from the WSFEX one.
ARCA_WSFE_SIGNER_URL=
ARCA_WSFE_SIGNER_TOKEN=
ARCA_BOUNDARY_URL=
ARCA_BOUNDARY_PAYLOAD_WRITE_TOKEN=
ARCA_ENVIRONMENT=homologacion
# Explicit acceptance gates; never enable these without the named external approvals.
ARCA_HOMOLOGATION_AUTHORIZED=false
ARCA_HOMOLOGATION_TEST_IDENTITY_APPROVED=false
# Server-side context for the authenticated FEXGetPARAM_PtoVenta homologation probe.
# The issuer profile reference is sent only in a bounded authenticated body and is
# reduced to a hash in the returned evidence receipt.
ARCA_HOMOLOGATION_WORKSPACE_ID=
ARCA_HOMOLOGATION_ISSUER_PROFILE_REF=
ARCA_WSFEX_DELEGATION_CONFIRMED=false
ARCA_WSFE_DELEGATION_CONFIRMED=false
ARCA_FEEWS_POINT_OF_SALE_CONFIRMED=false
TAX_ENGINE_PRODUCTION_APPROVED=false
# Isolated WSFEX signer deployment. ARCA_SIGNER_TOKEN and
# WSFEX_SIGNER_API_TOKEN must agree across their separate deployments.
WSFEX_SIGNER_API_TOKEN=
WSFEX_SIGNER_HOST=127.0.0.1
WSFEX_SIGNER_VAULT_URL=
WSFEX_SIGNER_VAULT_TOKEN=
WSFEX_WSAA_BROKER_URL=
WSFEX_WSAA_BROKER_TOKEN=
WSFEX_SIGNER_DB_PATH=/data/wsfex-signer.sqlite
WSFEX_SIGNER_VERSION=0.1.0
WSFEX_SIGNER_PRODUCTION_APPROVED=false
WSFEX_SEQUENCE_RESERVATIONS_REQUIRED=true
# Isolated WSFE (Factura C) signer deployment. ARCA_WSFE_SIGNER_TOKEN and
# WSFE_SIGNER_API_TOKEN must agree across their separate deployments. It shares
# the WSAA broker with WSFEX (service literal 'wsfe' vs 'wsfex').
WSFE_SIGNER_API_TOKEN=
WSFE_SIGNER_HOST=127.0.0.1
WSFE_SIGNER_VAULT_URL=
WSFE_SIGNER_VAULT_TOKEN=
WSFE_WSAA_BROKER_URL=
WSFE_WSAA_BROKER_TOKEN=
WSFE_SIGNER_DB_PATH=/data/wsfe-signer.sqlite
WSFE_SIGNER_VERSION=0.1.0
WSFE_SIGNER_PRODUCTION_APPROVED=false
# Isolated WSFECRED (FCE MiPyMEs) read-only lifecycle client deployment. Shares
# the WSAA broker with the signers (service literal 'wsfecred'); stores no
# authority payload, so it needs no vault. Motora points ARCA_WSFECRED_URL/TOKEN
# here; ARCA_WSFECRED_TOKEN and WSFECRED_API_TOKEN must agree across deployments.
ARCA_WSFECRED_URL=
ARCA_WSFECRED_TOKEN=
WSFECRED_API_TOKEN=
WSFECRED_WSAA_BROKER_URL=
WSFECRED_WSAA_BROKER_TOKEN=
WSFECRED_CLIENT_VERSION=0.1.0
# Tacit-acceptance window in días corridos. Resolución 219/2025 SEPYME = 21.
FCE_ACCEPTANCE_WINDOW_DAYS=21
WSFECRED_PRODUCTION_APPROVED=false
# Isolated encrypted authority boundary deployment. In the signer deployment,
# set its VAULT/WSAA URLs to this service and map the two corresponding tokens.
ARCA_BOUNDARY_PAYLOAD_RESOLVE_TOKEN=
ARCA_BOUNDARY_WSAA_TOKEN=
ARCA_BOUNDARY_ADMIN_TOKEN=
ARCA_BOUNDARY_HOST=127.0.0.1
ARCA_BOUNDARY_MASTER_KEY_FILE=/run/secrets/arca_boundary_master_key
# Separate stable HMAC key. Rotate only with an explicit commitment migration;
# ordinary encryption-key rotation must not change taxpayer authority identity.
ARCA_BOUNDARY_CUIT_COMMITMENT_KEY_FILE=/run/secrets/arca_boundary_cuit_commitment_key
# Terminal ciphertext retention begins only after exact official reconciliation.
ARCA_BOUNDARY_PAYLOAD_RETENTION_POLICY_ID=arca-authority-terminal-recovery-v1
ARCA_BOUNDARY_PAYLOAD_TERMINAL_RETENTION_DAYS=30
# Offline rotation command only; never set this on the running service.
ARCA_BOUNDARY_NEW_MASTER_KEY_FILE=
ARCA_BOUNDARY_DB_PATH=/data/arca-boundary.sqlite
ARCA_BOUNDARY_PRODUCTION_APPROVED=false
# Server-only Reclaim credentials and the two reviewed ARCA provider IDs.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_CALLBACK_BASE_URL=https://tax-api.example.com
RECLAIM_CALLBACK_MAX_BYTES=52428800
RECLAIM_ARCA_TAXPAYER_PROVIDER_ID=
RECLAIM_ARCA_TAXPAYER_PROVIDER_REVIEWED=false
RECLAIM_ARCA_CAE_PROVIDER_ID=
RECLAIM_ARCA_CAE_PROVIDER_REVIEWED=false
RECLAIM_ARCA_ONBOARDING_PROVIDER_ID=
RECLAIM_ARCA_ONBOARDING_PROVIDER_REVIEWED=false
# Optional hardening for providers configured to return Reclaim TEE attestations.
RECLAIM_REQUIRE_TEE=false
# Optional external encrypted proof custody. Raw proofs never enter the Motora database.
RECLAIM_PROOF_CUSTODY_REQUIRED=false
RECLAIM_PROOF_VAULT_URL=
RECLAIM_PROOF_VAULT_TOKEN=
RECLAIM_PROOF_RETENTION_POLICY_ID=
# Isolated proof-vault deployment only. Keep review/admin tokens out of Motora and the agent runtime.
RECLAIM_PROOF_VAULT_REVIEW_TOKEN=
RECLAIM_PROOF_VAULT_ADMIN_TOKEN=
RECLAIM_PROOF_VAULT_MASTER_KEY_FILE=/run/secrets/reclaim_proof_vault_master_key
# Offline rotation command only.
RECLAIM_PROOF_VAULT_NEW_MASTER_KEY_FILE=
RECLAIM_PROOF_VAULT_DB_PATH=/data/reclaim-proof-vault.sqlite
RECLAIM_PROOF_VAULT_PRODUCTION_APPROVED=false
